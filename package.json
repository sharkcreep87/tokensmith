{
  "name": "@sharkcreep87/tokensmith",
  "version": "1.0.0",
  "description": "TokenSmith — a Claude Code plugin and CLI that saves token usage through persistent memory, reusable skills, smart context injection, session compression, and usage analytics.",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tokensmith": "dist/cli/index.js",
    "ts-smith": "dist/cli/index.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "commands",
    "hooks",
    "skills",
    "docs/logo.svg",
    "docs/logo-dark.svg",
    "token-smith.config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./plugin": {
      "import": "./dist/plugin/index.js",
      "types": "./dist/plugin/index.d.ts"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "clean": "rm -rf dist coverage .tokensmith-test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "postinstall": "node -e \"console.log('\\n\\x1b[36m\\u2728 TokenSmith installed. Run tokensmith --help to get started.\\x1b[0m\\n')\""
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-code-plugin",
    "tokens",
    "token-saving",
    "llm",
    "ai",
    "memory",
    "context",
    "prompt-engineering",
    "compression",
    "cli"
  ],
  "author": "TokenSmith Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkcreep87/tokensmith.git"
  },
  "bugs": {
    "url": "https://github.com/sharkcreep87/tokensmith/issues"
  },
  "homepage": "https://github.com/sharkcreep87/tokensmith#readme",
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "cosmiconfig": "^9.0.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.2",
    "gpt-tokenizer": "^2.8.1",
    "nanoid": "^5.0.9",
    "ora": "^8.1.1",
    "tiktoken": "^1.0.18",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
