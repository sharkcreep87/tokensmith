# ---------------------------------------------------------------------------
# TokenSmith environment configuration
#
# All values are OPTIONAL. TokenSmith falls back to sensible defaults plus the
# project-local `token-smith.config.json` when env vars are not present.
# ---------------------------------------------------------------------------

# Absolute path to the SQLite database. Default: <project>/.tokensmith/tokensmith.db
TOKENSMITH_DB_PATH=

# Root directory used for per-project namespaces. Default: current working dir.
TOKENSMITH_PROJECT_ROOT=

# Token model used for counting. Supported: cl100k_base, o200k_base.
# Default: o200k_base (matches modern Claude/GPT-4o tokenization closely).
TOKENSMITH_TOKEN_MODEL=o200k_base

# Auto-compress session history when it exceeds this many tokens.
TOKENSMITH_COMPRESSION_THRESHOLD=8000

# Emit a warning when the projected prompt exceeds this many tokens.
TOKENSMITH_TOKEN_WARNING=80000

# When set to "1" the CLI writes all saved messages to the memory store.
TOKENSMITH_AUTO_SAVE_MEMORIES=0

# Preferred Claude model identifier (only used for reporting, not invocation).
TOKENSMITH_PREFERRED_MODEL=claude-sonnet-4-6

# Log level: silent | error | warn | info | debug
TOKENSMITH_LOG_LEVEL=info

# Disable ANSI color output (e.g. in CI). Set to "1" to force-disable.
TOKENSMITH_NO_COLOR=0

# Global kill switch. Set to "1" to disable ALL TokenSmith plugin hooks
# instantly. When disabled, hooks return an empty no-op response with
# essentially zero overhead (no DB open, no context build).
TOKENSMITH_DISABLED=0
